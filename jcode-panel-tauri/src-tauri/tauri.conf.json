{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jcode Panel",
  "version": "0.1.0",
  "identifier": "dev.jcode.panel",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run check && npm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "dropdown",
        "title": "Jcode Interaction",
        "url": "index.html?window=dropdown",
        "width": 420,
        "height": 620,
        "visible": false,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "prompt",
        "title": "Jcode Prompt",
        "url": "index.html?window=prompt",
        "width": 720,
        "height": 112,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Jcode Panel Settings",
        "url": "index.html?window=settings",
        "width": 720,
        "height": 520,
        "visible": false,
        "decorations": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
